  "adjustments": [
    {
      "token": "text/tertiary",
      "theme": "light",
      "figma": "neutral/400 (#8a93a3)",
      "used": "#636c7d",
      "reason": "Original Figma value was below 4.5:1. #636c7d reaches 4.8:1 on bg/canvas; Figma was reconciled to this value on 2026-10-19."
    },
    {
      "token": "text/tertiary",
      "theme": "dark",
      "figma": "neutral/500 (#6b7485)",
      "used": "neutral/400",
      "reason": "Original Figma value was below AA. neutral/400 reaches 5.2:1 on bg/surface-2; Figma was reconciled to this value on 2026-10-19."
    },
    {
      "token": "status/warning-ink, control/fill, control/ink",
      "theme": "both",
      "figma": "not defined (Figma uses status/success-ink and status/danger-ink only)",
      "used": "added so text colour and fill have named roles",
      "reason": "Badges need an ink for every tone, and Driver needs a high-contrast control. The values reuse existing Figma colours."
    },
    {
      "token": "Noto Sans Display, Sinhala font",
      "theme": "both",
      "figma": "Display/Title/Number text styles use Noto Sans Display; Sinhala local style uses Abhaya Libre",
      "used": "Noto Sans, Abhaya Libre Regular and Noto Sans Tamil",
      "reason": "User confirmed Abhaya Libre for both Figma and apps on 2026-10-19 after Noto Sans Sinhala could not load in the Figma account. The original offline-font decision is revised; bundled files retain SIL OFL licences."
    }
