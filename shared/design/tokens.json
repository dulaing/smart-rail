      "typeScale": 1,
      "minTextSize": 14,
      "figmaFrame": "User confirmed 2026-10-19: 2560x1600 tablet artwork maps uniformly at 0.5 to 1280x800 logical, DPR 2. Source type/spacing/radius roles remain in logical units. Phone artwork is 1080x2400 at 3x, mapping to 360x800 logical, DPR 3; it must not inherit the Passenger 0.4 scale. Targets remain at least 56 dp.",
      "overrides": {
        "light": {
          "status/success-ink": "#03543a",
          "status/warning-ink": "#7a3a05",
          "status/danger-ink": "#8a150f",
          "control/fill": "nav/active",
          "control/ink": "nav/active-ink"
        }
      },
      "overrideReason": "Driver text needs 7:1. Figma status inks reach 6.1 to 6.2, and white on teal reaches 5.1, so Driver uses darker inks and the dark navigation colour for primary controls."
    },
    "station": {
      "themes": ["light"],
      "textContrast": 7,
      "minTarget": 48,
      "spaceScale": 1,
      "radiusScale": 0.5,
      "typeScale": 1,
      "minTextSize": 24,
      "figmaFrame": "Display is designed for a 1920x1080 screen read from a distance.",
      "overrides": {
        "light": {
          "status/success-ink": "#03543a",
          "status/warning-ink": "#7a3a05",
          "status/danger-ink": "#8a150f",
          "control/fill": "nav/active",
          "control/ink": "nav/active-ink"
        }
      },
      "overrideReason": "Station text needs 7:1. Light mode uses the high-contrast status inks and dark controls already validated for the driver profile."
    }
  },

