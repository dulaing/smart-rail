      "used": "#636c7d",
      "reason": "Figma value is 2.8:1 on bg/canvas and 3.1:1 on bg/surface, below the 4.5:1 AA minimum for text. #636c7d reaches 4.8:1 on bg/canvas."
    },
    {
      "token": "text/tertiary",
      "theme": "dark",
      "figma": "neutral/500 (#6b7485)",
      "used": "neutral/400",
      "reason": "Figma value is 3.7:1 on bg/surface, below AA. neutral/400 reaches 5.2:1 on bg/surface-2."
    },
    {
      "token": "status/warning-ink, control/fill, control/ink",
      "theme": "both",
      "figma": "not defined (Figma uses status/success-ink and status/danger-ink only)",
      "used": "added so text colour and fill have named roles",
      "reason": "Badges need an ink for every tone, and Driver needs a high-contrast control. The values reuse existing Figma colours."
    },
