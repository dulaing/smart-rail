<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds also trust certificate authorities the developer installed on the device, such
     as the .NET development certificate for https://localhost. Release builds ignore this. -->
<network-security-config>
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
